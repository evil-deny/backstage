{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuyuan-api",
  "main": "worker.ts",
  "account_id": "b3309a0ca47ead7b703b6dfaaf02b4c2",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
