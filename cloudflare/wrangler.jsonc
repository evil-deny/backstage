    { "binding": "BACKUPS", "database_name": "fuyuan-backups", "database_id": "99f15e21-fbbd-4382-91d8-207f02138a75" }
  ],
  "vars": { "ADMIN_EMAILS": "gooddenny931213@gmail.com", "GOOGLE_CLIENT_ID": "316864349868-fl1s387dabtiftil9iettd2h2b9emf2l.apps.googleusercontent.com", "MIGRATION_READ_ONLY": "false" },
  "triggers": { "crons": ["10 19 * * *"] },
  "observability": { "enabled": true }
