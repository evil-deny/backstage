# Node does not load this automatically. Copy to .env and start using:
# node --env-file=.env server.js
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/backstage.sqlite
# Set true behind HTTPS in production; false only for local HTTP.
COOKIE_SECURE=false
